{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "yes": ["./src/index"],
      "@vritti/react-native-ui": ["./src/index"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true
  }
}
