{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@vritti/quantum-ui-native": ["./lib/index"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true
  }
}
