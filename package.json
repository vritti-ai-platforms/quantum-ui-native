  "files": [
    "lib",
    "dist",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "start": "pnpm --filter quantum-ui-native-example start",
    "ios": "pnpm --filter quantum-ui-native-example ios",
    "android": "pnpm --filter quantum-ui-native-example android",
    "pods": "cd example/ios && pod install",
    "example": "pnpm --filter quantum-ui-native-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build dist",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vritti-ai-platforms/quantum-ui-native.git"
  },
  "author": "Shyam sunder <shyamsunder.mittapally@gmail.com> (https://github.com/shyamsunder99)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vritti-ai-platforms/quantum-ui-native/issues"
  },
  "homepage": "https://github.com/vritti-ai-platforms/quantum-ui-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@callstack/liquid-glass": "^0.7.1",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-navigation/bottom-tabs": "8.0.0-alpha.22",
    "@react-navigation/native": "8.0.0-alpha.17",
    "@react-navigation/native-stack": "^7.14.10",
    "@release-it/conventional-changelog": "^10.0.6",
    "@shopify/flash-list": "^2.3.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@tanstack/react-query": "^5.96.2",
    "@types/lodash": "^4.17.0",
    "@types/react": "^19.2.0",
    "axios": "^1.14.0",
    "commitlint": "^20.5.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "lefthook": "^2.1.4",
    "lucide-react-native": "^1.7.0",
    "nativewind": "5.0.0-preview.3",
    "nitrogen": "^0.35.3",
    "postcss": "^8.5.0",
    "prettier": "^3.8.1",
    "react": "19.2.0",
    "react-hook-form": "^7.72.1",
    "react-native": "0.83.0",
    "react-native-builder-bob": "^0.41.0",
    "react-native-nitro-modules": "^0.35.3",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.4",
    "release-it": "^19.2.4",
    "tailwindcss": "^4.2.0",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@react-navigation/bottom-tabs": ">=8.0.0-alpha.0",
    "@react-navigation/native": ">=8.0.0-alpha.0",
    "@shopify/flash-list": ">=2.0.0",
    "lucide-react-native": ">=0.400.0",
    "nativewind": ">=5.0.0-preview.1",
    "react": "*",
    "react-native": "*",
    "react-native-css": "*",
    "react-native-nitro-modules": "^0.35.3",
    "react-native-reanimated": ">=3.3.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-screens": ">=4.20.0",
    "react-native-svg": ">=13.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "react-native-builder-bob": {
    "source": "lib",
    "output": "dist",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "endOfLine": "lf"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/dist/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.59.2"
  },
  "dependencies": {
    "@rn-primitives/accordion": "^1.4.0",
    "@rn-primitives/alert-dialog": "^1.4.0",
    "@rn-primitives/aspect-ratio": "^1.4.0",
    "@rn-primitives/avatar": "^1.4.0",
    "@rn-primitives/checkbox": "^1.4.0",
    "@rn-primitives/collapsible": "^1.4.0",
    "@rn-primitives/context-menu": "^1.4.0",
    "@rn-primitives/dialog": "^1.4.0",
    "@rn-primitives/dropdown-menu": "^1.4.0",
    "@rn-primitives/hover-card": "^1.4.0",
    "@rn-primitives/label": "^1.4.0",
    "@rn-primitives/menubar": "^1.4.0",
    "@rn-primitives/popover": "^1.4.0",
    "@rn-primitives/portal": "^1.4.0",
    "@rn-primitives/progress": "^1.4.0",
    "@rn-primitives/radio-group": "^1.4.0",
    "@rn-primitives/select": "^1.4.0",
    "@rn-primitives/separator": "^1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "@rn-primitives/switch": "^1.4.0",
    "@rn-primitives/tabs": "^1.4.0",
    "@rn-primitives/toggle": "^1.4.0",
    "@rn-primitives/toggle-group": "^1.4.0",
    "@rn-primitives/tooltip": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash": "^4.17.21",
    "tailwind-merge": "^3.5.0"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    }
  },
  "workspaces": [
    "example"
  ]
}
